ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY aim345_ring.py /tmp/aim345_ring.py
COPY aim345_oi1_patch.py /tmp/aim345_oi1_patch.py
COPY aim345_oi3_patch.py /tmp/aim345_oi3_patch.py
COPY aim345_oi3b_patch.py /tmp/aim345_oi3b_patch.py
COPY aim345_oi5_patch.py /tmp/aim345_oi5_patch.py
COPY aim345_oi5b_patch.py /tmp/aim345_oi5b_patch.py
RUN python3 /tmp/aim345_oi1_patch.py && python3 /tmp/aim345_oi3_patch.py && python3 /tmp/aim345_oi3b_patch.py && python3 /tmp/aim345_oi5_patch.py && python3 /tmp/aim345_oi5b_patch.py
