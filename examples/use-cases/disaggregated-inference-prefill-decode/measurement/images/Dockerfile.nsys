ARG BASE_IMAGE
FROM ${BASE_IMAGE}
# Investigation-only (OPEN-ITEMS-NODE8): Nsight Systems CLI, newest package in the image's NVIDIA devtools repo.
RUN apt-get update -qq && PKG=$(apt-cache search --names-only '^nsight-systems-20[0-9.]*$' | awk '{print $1}' | sort -V | tail -1) \
 && echo "installing $PKG" && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends $PKG \
 && rm -rf /var/lib/apt/lists/* && ln -sf $(ls -d /opt/nvidia/nsight-systems/*/bin/nsys | sort -V | tail -1) /usr/local/bin/nsys && nsys --version
